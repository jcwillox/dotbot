FROM golang:alpine AS build

ENV CGO_ENABLED=0

RUN apk add --no-cache git

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN go build -o "dotbot.bin" ./dotbot

FROM archlinux

RUN pacman -Syu --noconfirm zsh bash-completion bash sudo git

# create user 'test' with password '1'
RUN useradd -m -s /bin/bash -G wheel test \
    && echo "test:1" | chpasswd \
    && echo "%wheel ALL=(ALL:ALL) ALL" > /etc/sudoers.d/wheel \
    && echo "Defaults lecture=never" > /etc/sudoers.d/privacy

RUN mkdir -p /etc/bash_completion.d/ && mkdir -p /usr/share/zsh/vendor-completions/

### COPY BINARY & COMPLETIONS ###
COPY --from=build /app/dotbot.bin /usr/bin/dotbot
RUN dotbot completion bash > /etc/bash_completion.d/dotbot \
    && dotbot completion zsh > /usr/share/zsh/vendor-completions/_dotbot

### COPY TESTDATA ###
COPY testdata/dotfiles-remote /root/dotfiles
RUN dotbot set directory /root/dotfiles

USER test
COPY --chown=test:test testdata/dotfiles-remote /home/test/dotfiles
RUN dotbot set directory /home/test/dotfiles

ENV USER=test \
    TERM=xterm-256color \
    DOTBOT_NO_UPDATE=1 \
    DOTBOT_NO_UPDATE_REPO=1 \
    DOTBOT_DEBUG=0

WORKDIR /home/test

CMD ["bash", "-l"]
